{% extends 'base.html.twig' %}

{% block title %}Liste entretiens d'embauche{% endblock %}

{% block body %}

<div>
    <h1>Liste entretiens d'embauche</h1>

    <table>
        <thead>
            <tr>
                <th>Poste recherché</th>
                <th>Société</th>
                <th>Type de candidature</th>
                <th>Date</th>
                <th>Numéro tél</th>
                <th>Email</th>
                <th>LinkedIn</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            {% for jobInterview in jobInterviews %}
                <tr>
                    <td>{{ jobInterview.job }}</td>
                    <td>{{ jobInterview.society }}</td>
                    <td>{{ jobInterview.candidacyType }}</td>
                    <td>{{ jobInterview.date | date("d/m/Y") }}</td>
                    <td>{{ jobInterview.phoneNumber }}</td>
                    <td>{{ jobInterview.email }}</td>
                    <td>{{ jobInterview.linkedIn }}</td>
                    <td><a href="{{ url('view_job_interview', {'id': jobInterview.id }) }}">Voir</a> <a href="{{ url('edit_job_interview', {'id': jobInterview.id}) }}">Modifier</a> <button id="{{ jobInterview.id }}" class="delete">Supprimer</button></td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<div id="modal" hidden>
    <div>Confirmer la suppression ?</div>
    <div>
        <button id="delete_yes">Oui</button>
        <button id="delete_no">Non</button>
    </div>
</div>

<script>
    const deletes = Array.from(document.getElementsByClassName("delete"));
    const modal = document.getElementById("modal");
    let idDelete = "";
    
    deletes.map((d) =>
    {
        d.addEventListener("click", () =>
        {
            idDelete = d.id;
            modal.hidden = false;
        });
    });

    document.getElementById("delete_yes").addEventListener("click", () =>
    {
        window.location.href = "/job_interview/delete/" + idDelete;
    });

    document.getElementById("delete_no").addEventListener("click", () =>
    {
        modal.hidden = true;
    });
</script>
{% endblock %}
