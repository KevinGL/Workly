{% extends 'base.html.twig' %}

{% block title %}Modifier un entretien d'embauche{% endblock %}

{% block body %}

<div>
    <h1>Modifier un entretien d'embauche</h1>

    {{ form_start(form) }}
        {{ form_row(form.job) }}
        {{ form_row(form.society) }}
        {{ form_row(form.about) }}
        {{ form_row(form.candidacyType) }}
        {{ form_row(form.date) }}
        {{ form_row(form.phoneNumber) }}
        {{ form_row(form.email) }}
        {{ form_row(form.linkedIn) }}
        {{ form_row(form.address) }}
        {{ form_row(form.zipCode) }}
        {{ form_row(form.city) }}
        {{ form_row(form.answer) }}

        <input type="submit" />
    {{ form_end(form) }}
    
    <a href="{{ url('app_job_interview') }}">Revenir à la liste</a>
</div>
{% endblock %}
