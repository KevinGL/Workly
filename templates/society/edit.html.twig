{% extends 'base.html.twig' %}

{% block title %}Mettre à jour une société{% endblock %}

{% block body %}

<div>
    <h1>Mettre à jour une société</h1>

    {{ form_start(form) }}
        {{ form_row(form.name) }}
        {{ form_row(form.contactedAt) }}
        <div>
            {{ form_row(form.toRelaunchAt) }}
            <button type="button" id="setNullToRelaunchAt">Effacer</button>
        
        <div>
            {{ form_row(form.relaunchedAt) }}
            <button type="button" id="setNullRelaunchedAt">Effacer</button>
        </div>
        {{ form_row(form.phoneNumber) }}
        {{ form_row(form.email) }}
        {{ form_row(form.linkedIn) }}
        {{ form_row(form.recruit) }}
        {{ form_row(form.about) }}
        {{ form_row(form.result) }}
        {{ form_row(form.answer) }}

        <input type="submit" />
    {{ form_end(form) }}
    
    <a href="{{ url('app_society') }}">Revenir à la liste</a>
</div>

<script>
document.getElementById("setNullToRelaunchAt").addEventListener("click", () =>
{
    document.getElementById("society_toRelaunchAt").value = null;
});

document.getElementById("setNullRelaunchedAt").addEventListener("click", () =>
{
    document.getElementById("society_relaunchedAt").value = null;
});
</script>
{% endblock %}
